# ==============================================================================
# Arab Tarjima Bot — sozlamalar namunasi
# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni o'zingiznikiga almashtiring:
#   cp .env.example .env
# ".env" fayli GitHub'ga yuklanmaydi (.gitignore'da).
# ==============================================================================

# Server porti
PORT=3000

# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=your_telegram_bot_token

# Bot rejimi: 'polling' (lokal ishlatish uchun) yoki 'webhook' (HTTPS server uchun)
BOT_MODE=polling

# Webhook manzili (faqat BOT_MODE=webhook bo'lsa kerak)
WEBHOOK_URL=

# Admin paneli paroli (/admin) — kuchli parol qo'ying
ADMIN_PASSWORD=your_strong_admin_password

# Admin Telegram ID raqami (ixtiyoriy, faqat shu ID admin bo'la oladi)
ADMIN_TELEGRAM_ID=

# Google Gemini API kaliti (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# MongoDB ulanishi (lokal: mongodb://127.0.0.1:27017 yoki Atlas: mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=arab_tarjima_bot
